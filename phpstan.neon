includes:
	- phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    level: max
    phpVersion: 80300
    parallel:
        processTimeout: 300.0
    paths:
       - Classes

    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    reportAnyTypeWideningInVarTag: true

    ignoreErrors:
        # PasswordHasBeenResetEvent exists only in TYPO3 v14. The listener is documented as v14-only and is
        # never dispatched on v13, where registration by class-name string is harmless — but PHPStan cannot
        # resolve the type there. reportUnmatched keeps these inert (not "unmatched") on the v14 legs.
        -
            identifier: class.notFound
            path: Classes/EventListener/PasswordResetTokenRevocationListener.php
            reportUnmatched: false
        -
            identifier: argument.type
            message: '#\$beUserUid of method .*revokeByBackendUser\(\) expects int, mixed given#'
            path: Classes/EventListener/PasswordResetTokenRevocationListener.php
            reportUnmatched: false
        -
            identifier: parameter.internalClass
            message: '#BackendLayoutView#'
        -
            identifier: property.internalClass
            message: '#BackendLayoutView#'
        -
            identifier: method.internalClass
            message: '#BackendLayoutView#'
        # Compiling TypoScript outside a frontend request has no non-internal API: SysTemplateRepository,
        # FrontendTypoScriptFactory, FrontendTypoScript and the AST nodes are all marked @internal. Core's own
        # non-frontend caller, Extbase's BackendConfigurationManager, depends on exactly this surface, so the
        # risk is core's to manage and ours to re-check on a major upgrade. Scoped to the one file that does it.
        -
            identifier: parameter.internalClass
            path: Classes/Service/TypoScriptCompilerService.php
        -
            identifier: property.internalClass
            path: Classes/Service/TypoScriptCompilerService.php
        -
            identifier: method.internalClass
            path: Classes/Service/TypoScriptCompilerService.php
        -
            identifier: method.internal
            path: Classes/Service/TypoScriptCompilerService.php

    shipmonkRules:
        allowComparingOnlyComparableTypes:
            enabled: false
        forbidCheckedExceptionInCallable:
            enabled: false
        uselessPrivatePropertyDefaultValue:
            enabled: false
        forbidUnusedMatchResult:
            enabled: false
